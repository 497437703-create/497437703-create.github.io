<?xml version="1.0" encoding="utf-8"?>
<!-- SCH-900S is an on-premises appliance that may be served over plain HTTP inside the corporate
     network; Settings flags http:// profiles as unencrypted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
